<Window x:Class="Control.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C# Control Operator - Web SCADA" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#EEF3F7"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#102A32" Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0F766E" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0">
                        <TextBlock Text="C#" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="C# CONTROL OPERATOR" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Web SCADA · PLC Delta DVP · MQTT" Foreground="#8FB3B4" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" Foreground="#DCE9EE" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="LogoutButton" Content="Đăng xuất" Click="LogoutButton_Click" Visibility="Collapsed" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border x:Name="LoginPanel" Width="430" Background="White" CornerRadius="16" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Đăng nhập hệ thống" FontSize="24" FontWeight="Bold" Foreground="#172033"/>
                    <TextBlock Text="Phần mềm điều khiển C# dùng API của Control Service"
                               Foreground="#6B7A8C" Margin="0,6,0,18" TextWrapping="Wrap"/>
                    <TextBlock Text="API URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="ApiUrlBox" Text="http://localhost:5081" Padding="8" Margin="0,0,0,12"/>
                    <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameBox" Text="admin" Padding="8" Margin="0,0,0,12"/>
                    <TextBlock Text="Mật khẩu" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Password="Admin123!" Padding="8" Margin="0,0,0,12"/>
                    <TextBlock x:Name="LoginError" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="LoginButton" Content="Đăng nhập" Click="LoginButton_Click"
                            Background="#0F766E" Foreground="White" FontWeight="Bold" Padding="10" BorderThickness="0"/>
                    <TextBlock Text="Tài khoản dev mặc định: admin / Admin123! — đổi trước khi dùng thật."
                               Foreground="#6B7A8C" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Grid x:Name="MainPanel" Visibility="Collapsed" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bảng vận hành" FontSize="22" FontWeight="Bold" Foreground="#172033" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionText" Text="● POLLING" Foreground="#0F766E"
                                   FontWeight="Bold" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="StatusText" Foreground="#6B7A8C" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Làm mới" Click="RefreshButton_Click" Padding="12,6" Margin="0,0,8,0"/>
                    </StackPanel>
                </Grid>

                <TabControl Grid.Row="1">
                    <TabItem Header="Tổng quan">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                                    <StackPanel><TextBlock Text="Gateway online" Foreground="#6B7A8C"/><TextBlock x:Name="GatewayCountText" Text="—" FontSize="24" FontWeight="Bold"/></StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                                    <StackPanel><TextBlock Text="Tag" Foreground="#6B7A8C"/><TextBlock x:Name="TagCountText" Text="—" FontSize="24" FontWeight="Bold"/></StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="10" Padding="18">
                                    <StackPanel><TextBlock Text="Alarm active" Foreground="#6B7A8C"/><TextBlock x:Name="AlarmCountText" Text="—" FontSize="24" FontWeight="Bold"/></StackPanel>
                                </Border>
                            </StackPanel>
                            <DataGrid x:Name="GatewayGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"
                                      Background="White" BorderBrush="#DBE4EC" RowHeaderWidth="0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Tag dữ liệu">
                        <DataGrid x:Name="TagGrid" Margin="10" AutoGenerateColumns="True" IsReadOnly="True"
                                  Background="White" BorderBrush="#DBE4EC" RowHeaderWidth="0"/>
                    </TabItem>

                    <TabItem Header="Alarm">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid x:Name="AlarmGrid" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True"
                                      Background="White" BorderBrush="#DBE4EC" RowHeaderWidth="0"/>
                            <Button Grid.Row="1" Content="Xác nhận alarm đang chọn" Click="AckButton_Click"
                                    HorizontalAlignment="Right" Padding="12,6" Margin="0,8,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Điều khiển">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Tag ghi:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="TagCombo" Width="220" DisplayMemberPath="Name" Margin="0,0,10,0"/>
                                <TextBlock Text="Giá trị:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="CommandValueBox" Width="100" Text="1" Margin="0,0,10,0"/>
                                <Button Content="Gửi lệnh" Click="SendCommandButton_Click" Padding="12,4"
                                        Background="#0F766E" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                            <DataGrid x:Name="CommandGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"
                                      Background="White" BorderBrush="#DBE4EC" RowHeaderWidth="0"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
