menu "IoT Gateway"

config GW_WIFI_SSID
    string "Wi-Fi SSID (empty = use W5500 Ethernet)"
    default ""

config GW_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config GW_GATEWAY_ID
    string "Gateway ID used in MQTT topics"
    default "GW_001"

config GW_PLC_ID
    string "PLC ID reported in telemetry"
    default "PLC_001"

config GW_MQTT_URI
    string "MQTT broker URI"
    default "mqtt://192.168.1.100:1883"

config GW_MQTT_USERNAME
    string "MQTT username"
    default ""

config GW_MQTT_PASSWORD
    string "MQTT password"
    default ""

endmenu
